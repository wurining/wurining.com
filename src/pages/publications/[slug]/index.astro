---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostMeta from "../../../components/PostMeta.astro";
import Icon from "../../../components/Icon.astro";
import { getPublications, tagSlug } from "../../../lib/content";
import { site } from "../../../lib/site";
export async function getStaticPaths() {
  const posts = await getPublications();
  return posts.map((post, index) => ({ params: { slug: post.slug }, props: { post, previous: posts[index + 1], next: posts[index - 1] } }));
}
const { post, previous, next } = Astro.props;
const absoluteUrl = new URL(post.url, site.url).href;
const tweet = `https://x.com/intent/tweet/?${new URLSearchParams({ text: post.title, url: absoluteUrl, hashtags: post.tags.map((tag) => tag.replace(/\s/g, "")).join(",") })}`;
const linkedin = `https://www.linkedin.com/shareArticle?${new URLSearchParams({ mini: "true", url: absoluteUrl, title: post.title, summary: post.title, source: absoluteUrl })}`;
---
<BaseLayout title={post.title} description={post.description || post.summary} post={post} list={false}>
  <article class="post-single">
    <header class="post-header">
      <h1 class="post-title entry-hint-parent">{post.title}</h1>
      {post.description && <div class="post-description">{post.description}</div>}
      <div class="post-meta"><PostMeta post={post} /></div>
    </header>
    {post.cover?.image && !post.cover.hiddenInSingle && <figure class="entry-cover"><img loading="eager" src={post.cover.image} alt={post.cover.alt} />{post.cover.captionHtml && <p set:html={post.cover.captionHtml} />}</figure>}
    {post.showToc && post.tocHtml && <div class="toc"><details><summary accesskey="c" title="(Alt + C)"><span class="details">Table of Contents</span></summary><div class="inner" set:html={post.tocHtml} /></details></div>}
    <div class="post-content" set:html={post.html} />
    <footer class="post-footer">
      <ul class="post-tags">{post.tags.map((tag) => <li><a href={`/tags/${tagSlug(tag)}/`}>{tag}</a></li>)}</ul>
      {(previous || next) && <nav class="paginav">{previous && <a class="prev" href={previous.url}><span class="title">« Prev</span><br /><span>{previous.title}</span></a>}{next && <a class="next" href={next.url}><span class="title">Next »</span><br /><span>{next.title}</span></a>}</nav>}
      {!post.disableShare && <ul class="share-buttons"><li><a target="_blank" rel="noopener noreferrer" aria-label={`share ${post.title} on x`} href={tweet}><Icon name="share-x" /></a></li><li><a target="_blank" rel="noopener noreferrer" aria-label={`share ${post.title} on linkedin`} href={linkedin}><Icon name="share-linkedin" /></a></li></ul>}
    </footer>
  </article>
</BaseLayout>
