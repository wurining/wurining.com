---
import { site } from "../lib/site";
---
<footer class="footer">
  <div class="footer-navigation">
    <span>&copy; {new Date().getFullYear()} <a href="/">{site.author}</a></span>
    <nav aria-label="More pages"><a href="/archives/">Archive</a><a href="/tags/">Tags</a><a href="/index.xml">RSS</a><a href="https://sites.google.com/site/jiankliu/home">Lab page <span aria-hidden="true">↗</span></a></nav>
  </div>
  <div class="footer-details"><span>Built with <a href="https://astro.build/" rel="noreferrer">Astro</a></span><a href="https://beian.miit.gov.cn/" rel="noreferrer">京ICP备17059282号-1</a></div>
  {import.meta.env.PROD && <div class="visitor-map" id="visitor-map" aria-hidden="true"></div>}
</footer>
<a href="#top" aria-label="Back to top" title="Back to top (Alt + G)" class="top-link" id="top-link" accesskey="g" hidden>
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5m-6 6 6-6 6 6" /></svg>
</a>
<script>
  const topLink = document.getElementById("top-link");
  function updateTopLink() {
    if (topLink) topLink.hidden = window.scrollY < 800;
  }
  window.addEventListener("scroll", updateTopLink, { passive: true });
  updateTopLink();
  // Native fragment navigation preserves the URL and keyboard focus.
  // CSS handles smooth scrolling and its reduced-motion alternative.
</script>
