---
import { site } from "../lib/site";
import ThemeToggle from "./ThemeToggle";
import { externalLinkAttributes } from "../lib/links";
interface Props { dossier?: boolean; }
const { dossier = false } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<header class:list={["header", { "dossier-header": dossier }]}>
  <nav class="nav" aria-label="Main navigation">
    {!dossier && <div class="logo"><a href="/" accesskey="h" title={`${site.title} (Alt + H)`}>{site.author}</a></div>}
    <ul id="menu">
      {site.menu.map((item) => {
        const active = item.url === "/" ? pathname === "/" || pathname.startsWith("/publications") : pathname === item.url.replace(/\/$/, "");
        const search = item.url === "/search/";
        const external = externalLinkAttributes(item.url);
        return <li><a href={item.url} {...external} aria-current={active ? "page" : undefined} title={search ? "Search (Alt + /)" : undefined} accesskey={search ? "/" : undefined}><span class:list={{ active }}>{item.name}{external.target && <span aria-hidden="true"> ↗</span>}</span></a></li>;
      })}
    </ul>
    <div class="theme-control"><ThemeToggle client:load /></div>
  </nav>
</header>
