---
import Icon from "./Icon.astro";
import Arrow from "./Arrow.astro";
import { Image } from "astro:assets";
import portrait from "../assets/profile.png";
import { profile } from "../lib/profile";
const home = Astro.url.pathname === "/";
function iconName(label: string) {
  if (/scholar/i.test(label)) return "googlescholar";
  if (/linkedin/i.test(label)) return "linkedin";
  if (/github/i.test(label)) return "github";
  return "";
}
---
<aside class="profile-sidebar" aria-label="Personal profile">
  <div class="profile-identity" data-reveal>
    <Image class="profile-photo" src={portrait} alt={`Illustrated portrait of ${profile.name}`} width={144} height={144} densities={[1, 2]} format="webp" quality={85} loading="eager" decoding="async" />
    {home ? <h1 class="profile-name">{profile.name}</h1> : <a class="profile-name" href="/">{profile.name}</a>}
    <p class="profile-role">{profile.role}</p>
    <p class="profile-affiliation">{profile.affiliation}</p>
  </div>
  <div class="profile-summary" data-reveal data-reveal-delay="70">
    {profile.bioParagraphs.map((paragraph) => <p class="profile-bio">{paragraph}</p>)}
  </div>
  <nav class="profile-links" aria-label="Profile links" data-reveal data-reveal-delay="120">
    {profile.links.map((link) => <a class="text-link" href={link.href} rel="me noreferrer">
      <span class="profile-link-icon" aria-hidden="true">{iconName(link.label) ? <Icon name={iconName(link.label)} /> : <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M8 10v6m0-9v.2M12 10h2a3 3 0 0 1 0 6h-2Z" /></svg>}</span>
      <span>{link.label}</span>
    </a>)}
    <a class="text-link profile-about-link" href="/about/">
      <svg class="profile-link-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z" /><path d="M14 3v6h6M8 13h8M8 17h5" /></svg>
      <span>About &amp; experience</span><Arrow />
    </a>
  </nav>
</aside>
